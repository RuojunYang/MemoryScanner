<Window x:Class="MemoryScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="内存扫描器"
        Width="1080"
        Height="720"
        MinWidth="900"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16" Background="White" CornerRadius="7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="12" Foreground="#6B7280" Text="目标进程" />
                    <ComboBox Margin="0,5,12,0"
                              Width="580"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding Processes}"
                              SelectedItem="{Binding SelectedProcess}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="20"
                                           Height="20"
                                           HorizontalAlignment="Left"
                                           Source="{Binding Icon}"
                                           Stretch="Uniform" />
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <Button Grid.Column="1"
                        Margin="0,20,8,0"
                        Command="{Binding RefreshProcessesCommand}"
                        Content="刷新列表" />
                <Button Grid.Column="2"
                        Margin="0,20,0,0"
                        Command="{Binding OpenProcessCommand}"
                        Content="打开进程" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="16" Background="White" CornerRadius="7">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="扫描设置" />
                    <TextBlock Margin="0,18,0,5" Foreground="#4B5563" Text="整数类型" />
                    <ComboBox ItemsSource="{Binding IntegerTypes}"
                              SelectedItem="{Binding SelectedType}"
                              DisplayMemberPath="DisplayName" />
                    <TextBlock Margin="0,14,0,5" Foreground="#4B5563" Text="精确数值（十进制）" />
                    <TextBox Text="{Binding ScanValue, UpdateSourceTrigger=PropertyChanged}" />
                    <WrapPanel Margin="0,16,0,0">
                        <Button Command="{Binding FirstScanCommand}" Content="首次扫描" />
                        <Button Command="{Binding NextScanCommand}" Content="再次扫描" />
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Command="{Binding NewScanCommand}" Content="新扫描" />
                        <Button Command="{Binding StopCommand}" Content="停止" />
                    </WrapPanel>
                    <Separator Margin="0,20,0,16" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="修改选中地址" />
                    <TextBlock Margin="0,12,0,5" Foreground="#4B5563" Text="写入数值（十进制）" />
                    <TextBox Text="{Binding WriteValue, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding WriteCommand}"
                            Content="写入并校验" />
                    <Separator Margin="0,20,0,14" />
                    <TextBlock Foreground="#6B7280" Text="当前连接" />
                    <TextBlock Margin="0,4,0,0"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Text="{Binding ConnectedProcessText}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Padding="16" Background="White" CornerRadius="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="扫描结果" />
                        <TextBlock Margin="12,3,0,0"
                                   Foreground="#6B7280"
                                   Text="{Binding TotalResultCount, StringFormat=共 {0:N0} 个}" />
                    </DockPanel>
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Results}"
                              SelectedItem="{Binding SelectedResult}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="2*" Header="地址" Binding="{Binding AddressText}" />
                            <DataGridTextColumn Width="*" Header="当前值" Binding="{Binding Value}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Padding="12,9" Background="#111827" CornerRadius="6">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right"
                             Width="120"
                             Height="8"
                             Margin="16,0,0,0"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
                <TextBlock Foreground="White"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding StatusText}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
